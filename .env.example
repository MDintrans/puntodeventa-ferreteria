# Copia este archivo como .env.local y pega la conexión "Pooled" de Neon.
# Esta variable es exclusiva del servidor y nunca debe comenzar con VITE_.
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Configuración opcional del servidor.
SESSION_HOURS=12
DB_POOL_SIZE=10
COOKIE_SECURE=false
